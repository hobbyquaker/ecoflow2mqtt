{
  "name": "ecoflow2mqtt",
  "version": "0.2.0",
  "description": "Interface between EcoFlow STREAM / PowerStream micro-inverters and MQTT",
  "type": "module",
  "main": "index.js",
  "preferGlobal": true,
  "bin": {
    "ecoflow2mqtt": "index.js"
  },
  "files": [
    "index.js",
    "config.js",
    "lib/"
  ],
  "engines": {
    "node": "^20.19 || ^22.12 || >=24"
  },
  "scripts": {
    "start": "node index.js",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "deploy": "bash deploy.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hobbyquaker/ecoflow2mqtt.git"
  },
  "keywords": [
    "mqtt",
    "smarthome",
    "mqtt-smarthome",
    "mqtt-interfaces",
    "home-automation",
    "home-assistant",
    "ecoflow",
    "powerstream",
    "stream",
    "microinverter",
    "solar",
    "pv"
  ],
  "author": "Sebastian Raff <hobbyquaker@gmail.com> (https://hobbyquaker.github.io)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hobbyquaker/ecoflow2mqtt/issues"
  },
  "homepage": "https://github.com/hobbyquaker/ecoflow2mqtt",
  "mqttInterfaces": {
    "spec": "2.0",
    "envPrefix": "ECOFLOW2MQTT",
    "needs": [
      "network",
      "cloud"
    ],
    "serviceExtra": []
  },
  "dependencies": {
    "mqtt": "^5.10.0",
    "mqtt-interfaces-core": "^0.8.0",
    "protobufjs": "^7.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0"
  }
}
